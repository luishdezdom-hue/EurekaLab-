rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Phase 4 requirement)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Individual Student Account Rules
    // Rule: Students can ONLY access and modify their own individual account.
    match /students/{studentId} {
      allow get: if isOwner(studentId);
      allow list: if false; // Forbid listing other students' accounts!

      allow create: if isOwner(studentId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 60
        && request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 30
        && request.resource.data.grade in ['3ro', '4to', '5to', '6to']
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0;

      allow update: if isOwner(studentId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.username == resource.data.username
        && request.resource.data.grade == resource.data.grade; // Forbid arbitrary grade tampering

      allow delete: if false;

      // Subcollection for individual evaluation attempts and mission logs
      match /history/{historyId} {
        allow get, list: if isOwner(studentId);
        allow create: if isOwner(studentId)
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.subject in ['matematicas', 'algoritmos', 'lectura']
          && request.resource.data.score is number;
        allow update, delete: if false; // Academic logs are immutable
      }
    }

    // Username Index: Ensures unique usernames and allows username-based authentication lookup
    match /usernames/{username} {
      allow get: if true; // Public read needed to verify uniqueness and look up username for login
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(username)
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
